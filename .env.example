# ============================================================
# CodeMastery — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values for your environment.
# Every value below is OPTIONAL in development (sensible defaults apply),
# but you MUST override secrets and URLs in production (Vercel / Railway / etc.).
#
# >>> DEPLOYING TO VERCEL? <<<
# You do NOT need a .env file locally. Instead, set these env vars in the
# Vercel dashboard (Project → Settings → Environment Variables):
#   DATABASE_URL          (from Neon / Supabase / Railway Postgres — see docs/deployment-vercel.md)
#   AUTH_SECRET           (generate with: openssl rand -base64 32)
#   NEXTAUTH_URL          (your Vercel URL, e.g. https://your-app.vercel.app)
#   NEXT_PUBLIC_APP_URL   (same as NEXTAUTH_URL)
#   STORAGE_PROVIDER=s3   (Vercel filesystem is ephemeral — use S3/R2/B2)
#   + storage credentials
# ------------------------------------------------------------

# ---------- Application ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Database ----------
# Two providers are supported via two schema files:
#   - PostgreSQL (DEFAULT — for Vercel / Neon / Supabase / Railway prod):
#       schema.prisma            → bun run db:push / db:seed
#   - SQLite (optional local dev, no Docker needed):
#       schema.sqlite.prisma     → bun run db:push:sqlite / db:seed:sqlite
#
# --- PostgreSQL (production — Neon / Supabase / Railway / RDS) ---
DATABASE_URL=postgresql://user:password@localhost:5432/codemastery
# Example Neon URL:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/codemastery?sslmode=require
# Example Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# --- SQLite (optional local dev only — uses schema.sqlite.prisma) ---
# To use SQLite locally, comment out the PostgreSQL URL above and use:
# DATABASE_URL=file:./db/custom.db
# Then run: bun run db:push:sqlite && bun run db:seed:sqlite
DATABASE_PROVIDER=postgresql

# ---------- Authentication ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-insecure-secret-change-me-0x9f3a
NEXTAUTH_SECRET=dev-insecure-secret-change-me-0x9f3a
NEXTAUTH_URL=http://localhost:3000

# ---------- Storage ----------
# Provider: local | s3
# IMPORTANT for Vercel: Vercel's serverless filesystem is EPHEMERAL — uploaded
# files will be lost between requests. Use S3-compatible storage in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE=/uploads

# S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi, Alibaba OSS, Tencent COS)
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://your-bucket.s3.region.amazonaws.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_BUCKET=your-bucket
# STORAGE_PUBLIC_URL=https://cdn.example.com
# STORAGE_S3_FORCE_PATH_STYLE=false

# ---------- AI (OPTIONAL — platform works without it) ----------
# When enabled, an AI Study Buddy appears in the tutorial reader, letting
# learners ask questions about the tutorial content. The core platform works
# fully without AI — this is a pure value-add feature.
AI_ENABLED=false
# Provider: none (default) | openai | zai
AI_PROVIDER=none
# OpenAI-compatible (OpenAI, Together, Groq, local llama-server, ...)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Z.AI SDK (optional — only if AI_PROVIDER=zai; lazy-imported)
# ZAI_API_KEY=your-zai-api-key

# ---------- Search (OPTIONAL) ----------
# Provider: db | meilisearch | elasticsearch
SEARCH_PROVIDER=db
# MEILI_HOST=http://localhost:7700
# MEILI_API_KEY=your-meili-key

# ---------- Email (OPTIONAL — console logger by default) ----------
EMAIL_PROVIDER=console
EMAIL_FROM=CodeMastery <no-reply@codemastery.dev>
# SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# SMTP_SECURE=false

# ---------- Rate Limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
