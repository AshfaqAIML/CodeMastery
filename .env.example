# ============================================================
# CodeMastery — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values for your environment.
# Every value below is OPTIONAL in development (sensible defaults apply),
# but you SHOULD override secrets and URLs in production.
# ------------------------------------------------------------

# ---------- Application ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Database ----------
# PostgreSQL (Neon / Supabase / Railway / local)
DATABASE_URL=postgresql://user:password@host:5432/codemastery?sslmode=require
DATABASE_PROVIDER=postgresql

# SQLite (dev-only fallback)
# DATABASE_URL=file:./db/custom.db
# DATABASE_PROVIDER=sqlite

# ---------- Authentication ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-insecure-secret-change-me-0x9f3a
NEXTAUTH_SECRET=dev-insecure-secret-change-me-0x9f3a
# IMPORTANT: For production, set NEXTAUTH_URL to your Vercel URL (e.g. https://your-project.vercel.app)
# Without this, NextAuth auto-detects the URL which can cause modal positioning issues
# (dim background with panel at bottom). Set this on Vercel dashboard or in .env.
NEXTAUTH_URL=http://localhost:3000

# ---------- Storage ----------
# Provider: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/tmp/uploads
STORAGE_PUBLIC_BASE=/tmp/uploads

# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, Wasabi, ...)
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://your-bucket.s3.region.amazonaws.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_BUCKET=your-bucket
# STORAGE_PUBLIC_URL=https://cdn.example.com
# STORAGE_S3_FORCE_PATH_STYLE=false

# ---------- AI (OPTIONAL — platform works without it) ----------
# When enabled, an AI Study Buddy appears in the tutorial reader, letting
# learners ask questions about the tutorial content. The core platform works
# fully without AI — this is a pure value-add feature.
AI_ENABLED=false
# Provider: zai | openai | none
AI_PROVIDER=none
# Z.AI (dev environment default)
# ZAI_API_KEY=your-zai-api-key
# OpenAI-compatible (OpenAI, Together, Groq, local, ...)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Search (OPTIONAL) ----------
# Provider: db | meilisearch | elasticsearch
SEARCH_PROVIDER=db
# MEILI_HOST=http://localhost:7700
# MEILI_API_KEY=your-meili-key

# ---------- Email (OPTIONAL — console logger by default) ----------
EMAIL_PROVIDER=console
EMAIL_FROM=CodeMastery <no-reply@codemastery.dev>
# SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# SMTP_SECURE=false

# ---------- Rate Limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
